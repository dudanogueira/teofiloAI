# Copie este arquivo para .env e troque os valores.
# O .env fica fora do git (veja o .gitignore); este .env.example vai para o git
# só para mostrar quais variáveis existem.
POSTGRES_USER=contador
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=contador

# Chave que assina o cookie de login. Gere uma sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

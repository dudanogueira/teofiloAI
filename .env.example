# Copie este arquivo para ".env" e preencha a chave do provedor escolhido.
#   cp .env.example .env
#
# O ".env" está no .gitignore — ele NÃO vai para o Git. O .env.example, sim.
# Usado apenas pela versão local/Docker (curso_agente_leis_local_docker.ipynb).

# Qual provedor usar: "cohere" ou "openai".
# Ele define AO MESMO TEMPO quem vetoriza (módulo text2vec-* do Weaviate)
# e quem responde (o LLM do agente).
PROVEDOR=cohere

# Trial key gratuita: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Exige créditos pré-pagos: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Onde o contêiner está. Só mude se não for o docker-compose.yml deste repositório.
WEAVIATE_HOST=localhost
